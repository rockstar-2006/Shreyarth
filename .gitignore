# ==========================================
# SMVITM Scholarship Portal - Git Ignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Environment & Sensitive Credentials (CRITICAL - NEVER COMMIT)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Firebase & Cloud Credentials
*firebase*adminsdk*.json
*serviceAccount*.json
*credentials*.json
.firebase/
firebase-debug.log*
firestore-debug.log*

# Next.js & Build Outputs
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Vercel & Deployment Artifacts
.vercel

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Sensitive Student Data Spreadsheets (Uploaded / Sample Registry)
*.xlsx
*.xls
*.csv
!public/*.csv
!public/*.xlsx

# OS & Editor Metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
